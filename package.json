{
  "name": "riasly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "prebuild": "npm run check:i18n",
    "check:i18n": "node scripts/i18n-audit.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "discord:worker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/discord-presence-worker.mjs",
    "templates:build": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-templates.mjs",
    "templates:verify": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-templates.mjs --verify",
    "templates:repoint": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/repoint-template-urls.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^14.0.0",
    "next": "^15.5.27",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "nodemailer": "^8.0.11",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.14.10",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.5.3",
    "vitest": "^3.2.7"
  }
}
