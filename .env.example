# riasly — environment template. Copy to .env and fill real values.

# MySQL connection (Prisma). Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/riaslylol"

# Auth.js (Auth v5). Generate a secret, e.g.: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Canonical public origin used to build embeds (a Twitch player's `parent`, etc.).
# Optional: appOrigin() falls back to NEXT_PUBLIC_APP_URL, then localhost, so you
# only need this if the public URL differs from APP_URL (e.g. behind a CDN/domain).
NEXT_PUBLIC_SITE_URL=""

# OAuth providers are OPTIONAL. Add any you want; login buttons appear only when set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# OPTIONAL: live "Playing ..." on the Discord card, from our own bot instead of
# Lanyard. Leave both empty to keep the Lanyard fallback (npm run discord:worker).
# DISCORD_BOT_TOKEN = bot token from the Developer Portal. Used by the worker AND
#   by lib/discord.ts to read each user's authoritative public badge flags via
#   GET /users/{id}. Without it, badges fall back to the owner's OAuth self-view.
# DISCORD_GUILD_ID  = our server's id; connected users are auto-added to it
# DISCORD_WORKER_PORT = loopback port the worker uses as its single-instance lock
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
# DISCORD_WORKER_PORT="8757"

# Public invite the Account page's "Hemen katıl" button opens (a plain link, no bot
# permission needed). Defaults in code to https://discord.gg/uZK6UVR7YJ if unset.
DISCORD_INVITE_URL="https://discord.gg/uZK6UVR7YJ"

# File hosting (local disk MVP)
# Deliberately NOT under public/: Next.js serves public/ as static files with no
# auth and no middleware hook, so bytes stored there are readable by URL and
# FileAsset.isPrivate never runs. Every read goes through /api/files or /api/media
# instead — see the header comment in lib/storage.ts.
UPLOAD_DIR="./storage/uploads"
# 100 MB comfortably fits a 10-30s 4K H.264 loop; a 4K source cannot be upscaled from smaller
MAX_UPLOAD_MB="100"
# Per-account total for FREE plans, in GB — the number the pricing card promises
# ("5 GB file hosting"). Premium is unlimited by design. Set 0 to disable the check.
FILE_QUOTA_GB="5"

# Ceiling for an uploaded avatar specifically: it renders in a 112px circle, so a
# wall-sized clip would be pure wasted bandwidth for every visitor.
AVATAR_MAX_MB="8"

# Custom profile backgrounds (self-uploaded video/GIF): minimum account age in days.
# Leave unset for the default of 7.
CUSTOM_BG_MIN_ACCOUNT_DAYS="7"

# Comma-separated emails allowed to grant/revoke badges from /dashboard/badges.
# Empty = the admin panel is hidden for everyone.
ADMIN_EMAILS=""

# Widget/tab free-plan ceilings (only LOWER these; the code caps them at 3/1/3).
# FREE users get at most this many total widgets, extra tabs, and per-page widgets.
# WIDGET_FREE_LIMIT="3"
# PAGES_FREE_LIMIT="1"
# WIDGET_PER_PAGE_FREE_LIMIT="3"

# Anti-squat: stop users farming public handles.
# Days a user must wait between handle changes (first claim is always exempt).
# Set to 0 to disable the cooldown entirely.
HANDLE_CHANGE_COOLDOWN_DAYS="30"
# Max signup attempts allowed per IP in a rolling hour (backed by SignupAttempt).
SIGNUP_IP_HOURLY_LIMIT="3"

# Email verification for new accounts: signup mails a 6-digit code and login stays
# blocked until it is entered (see lib/email-verify.ts). The gate self-disables when
# the SMTP block below is unset — with no transport nothing can deliver a code, so
# forcing it would reject every signup and `git clone && npm run dev` would not work.
# Set to "false" to keep SMTP for the other mail flows but leave signup as it was.
# Accounts created before this feature are never affected either way.
REQUIRE_EMAIL_VERIFICATION="true"
# Max verification codes one IP may start in a rolling hour (EmailVerifyToken.ip).
VERIFY_IP_HOURLY_LIMIT="5"

# Email (SMTP via Nodemailer) — used to send the email-change confirmation code, the
# 2FA login code and the account-verification code. Leave unset to disable sending
# (those flows then fail closed with a "couldn't send" message rather than showing
# the code in-app).
#   Gmail example: host=smtp.gmail.com port=465 user=<you>@gmail.com pass=<app password>
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Optional sender address; defaults to SMTP_USER when empty.
SMTP_FROM=""
